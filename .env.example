# ------------------------------------------------------------------
# Configurazione del modulo contatti (SMTP)
# Copia questo file in ".env" e compila i valori reali.
# ------------------------------------------------------------------

SMTP_HOST=smtp.tuodominio.it
SMTP_PORT=587
SMTP_USER=info@tuodominio.it
SMTP_PASS=la-tua-password
# tls | ssl | none
SMTP_SECURE=tls

# Mittente mostrato nelle email
MAIL_FROM=info@tuodominio.it
MAIL_FROM_NAME=OpenChamber

# Destinatario che riceve i messaggi del form
CONTACT_TO=info@tuodominio.it
