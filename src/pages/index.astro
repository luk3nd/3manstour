---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeAbout from '../components/HomeAbout.astro';
import HomeTopics from '../components/HomeTopics.astro';
import FeaturedReportage from '../components/FeaturedReportage.astro';
import HomeStats from '../components/HomeStats.astro';
import HomeJournal from '../components/HomeJournal.astro';
import Gallery from '../components/Gallery.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import HomeCta from '../components/HomeCta.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';
import { organization } from '../lib/schema';

const byDate = (a: { data: { pubDate: Date } }, b: { data: { pubDate: Date } }) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate);
const authors = (await getCollection('authors')).sort((a, b) => a.id.localeCompare(b.id));
const galleryItems = (await getCollection('gallery', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);

/** Il "Reportage scelto" è il più recente articolo con "In evidenza" attivo. */
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
/** Il diario non ripete l'articolo già mostrato sopra. */
const journalPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 3);

const siteUrl = Astro.site ?? new URL(SITE.url);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: siteUrl.href,
    description: SITE.description,
    inLanguage: SITE.lang,
  },
  organization(siteUrl),
];
---

<BaseLayout jsonLd={jsonLd}>
  <HomeHero />

  <HomeAbout authors={authors} />

  <HomeTopics />

  {featuredPost && <FeaturedReportage post={featuredPost} />}

  <HomeStats />

  <HomeJournal posts={journalPosts} total={posts.length} />

  <Gallery
    items={galleryItems.map((item) => ({
      image: item.data.image,
      alt: item.data.alt,
      caption: item.data.caption,
    }))}
  />

  <InstagramFeed />

  <HomeCta />
</BaseLayout>
