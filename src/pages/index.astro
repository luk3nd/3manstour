---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedSlider from '../components/FeaturedSlider.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import AuthorCard from '../components/AuthorCard.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroImg from '../assets/hero.jpg';
import stockFiere from '../assets/stock-fiere.jpg';
import stockRistoranti from '../assets/stock-ristoranti.jpg';
import stockLuoghi from '../assets/stock-luoghi.jpg';
import stockEsperienze from '../assets/stock-esperienze.jpg';
import { SITE, CATEGORIES, SOCIAL, CONTACT } from '../config';

const categoryImages: Record<string, ImageMetadata> = {
  fiere: stockFiere,
  ristoranti: stockRistoranti,
  luoghi: stockLuoghi,
  esperienze: stockEsperienze,
};

const byDate = (a: { data: { pubDate: Date } }, b: { data: { pubDate: Date } }) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate);
const authors = await getCollection('authors');

const featured = posts.filter((p) => p.data.featured).slice(0, 6);

const countFor = (id: string) => posts.filter((p) => p.data.author.id === id).length;

const siteUrl = Astro.site ?? new URL(SITE.url);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: siteUrl.href,
    description: SITE.description,
    inLanguage: SITE.lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: siteUrl.href,
    logo: new URL('/favicon.png', siteUrl).href,
    email: CONTACT.email,
    sameAs: SOCIAL.map((s) => s.href),
    address: { '@type': 'PostalAddress', addressLocality: 'Brescia', addressCountry: 'IT' },
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <!-- ================= HERO ================= -->
  <section class="relative flex min-h-[92vh] items-center justify-center overflow-hidden">
    <Image
      src={heroImg}
      alt=""
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      format="webp"
      data-hero-image
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-night-950 via-night-950/60 to-night-950/40"></div>

    <div class="relative z-10 container-page py-24 text-center">
      <p class="eyebrow" data-hero-item>3 in viaggio</p>
      <h1
        class="mx-auto mt-5 max-w-4xl font-display text-5xl font-semibold leading-[1.05] text-white sm:text-7xl"
        data-hero-item
      >
        Non i posti più visti. Quelli giusti.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-300 sm:text-xl" data-hero-item>
        {SITE.description}
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3" data-hero-item>
        <a
          href="/blog/"
          class="rounded-lg bg-brand-500 px-6 py-3 text-sm font-semibold text-night-950 transition hover:bg-brand-400"
        >
          Inizia a esplorare
        </a>
        <a
          href="/chi-siamo/"
          class="rounded-lg border border-white/20 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
        >
          Il progetto
        </a>
      </div>
    </div>
  </section>

  <!-- ================= MANIFESTO ================= -->
  <section data-reveal class="container-page py-20 sm:py-28">
    <div class="mx-auto max-w-3xl text-center" data-animate>
        <p class="eyebrow">Il nostro sguardo</p>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight text-white sm:text-5xl">
          Non collezioniamo indirizzi. Cerchiamo storie da vivere.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-neutral-400">
        Ci piacciono le scoperte, ma non cerchiamo l’insolito a tutti i costi. Seguiamo la curiosità,
        andiamo a vedere con i nostri occhi e poi raccontiamo cosa rende un posto speciale — o cosa
        sapere prima di partire.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-3">
      {
        [
          { n: 'Curiosità, prima di tutto', d: 'Ci interessa ciò che ha una voce propria: un’idea, una storia o un modo diverso di fare le cose.' },
          { n: 'Esperienza sul posto', d: 'Preferiamo esserci, guardarci intorno e farci un’opinione diretta invece di fermarci alle foto.' },
          { n: 'Racconti utili e sinceri', d: 'Condividiamo ciò che ci ha colpito, con dettagli concreti per aiutarti a decidere se fa per te.' },
        ].map((item, i) => (
          <div class="rounded-2xl border border-white/10 bg-night-900 p-8" data-animate>
            <span class="font-mono text-3xl font-semibold text-brand-500">0{i + 1}</span>
            <h3 class="mt-4 text-xl font-semibold text-white">{item.n}</h3>
            <p class="mt-2 text-neutral-400">{item.d}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= CATEGORIE ================= -->
  <section id="categorie" data-reveal class="border-t border-white/10 bg-night-900/50 py-20 sm:py-28">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center" data-animate>
        <p class="eyebrow">Cosa esploriamo</p>
        <h2 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">
          Quattro modi di partire
        </h2>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          CATEGORIES.map((cat, i) => (
            <a
              href={`/blog/categoria/${cat.slug}/`}
              class="group relative flex min-h-[340px] flex-col overflow-hidden rounded-2xl border border-white/10 bg-night-900 p-7 transition-colors hover:border-brand-500/50"
              data-animate
              data-tilt
              style={`transition-delay:${(i % 4) * 80}ms`}
            >
              <Image
                src={categoryImages[cat.slug]}
                alt=""
                widths={[400, 640, 960]}
                sizes="(min-width:1024px) 25vw, (min-width:640px) 50vw, 100vw"
                format="webp"
                data-parallax="5"
                class="absolute inset-0 h-full w-full object-cover opacity-45 transition-opacity duration-700 group-hover:opacity-70"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-night-950 via-night-950/70 to-night-950/25"></div>
              <div class="relative flex flex-1 flex-col">
                <span class="font-mono text-xs text-neutral-300">0{i + 1}</span>
                <div class="mt-auto">
                  <h3 class="text-xl font-semibold text-white transition group-hover:text-brand-400">
                    {cat.label}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-neutral-300">{cat.description}</p>
                  <span class="mt-5 inline-flex items-center gap-2 rounded-lg border border-white/20 bg-night-950/40 px-4 py-2 text-sm font-medium text-white backdrop-blur transition group-hover:border-brand-500 group-hover:bg-brand-500 group-hover:text-night-950">
                    Esplora
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= INSTAGRAM ================= -->
  <InstagramFeed />

  <!-- ================= DAL DIARIO ================= -->
  <section data-reveal class="container-page py-20 sm:py-28">
    <div class="flex flex-wrap items-end justify-between gap-4" data-animate>
      <div>
        <p class="eyebrow">Dal diario</p>
        <h2 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">In evidenza</h2>
      </div>
      <a href="/blog/" class="text-sm font-medium text-brand-400 transition hover:text-brand-300">
        Tutti gli articoli →
      </a>
    </div>

    <div class="mt-10" data-animate>
      <FeaturedSlider posts={featured} />
    </div>
  </section>

  <!-- ================= CHI ESPLORA ================= -->
  <section data-reveal class="border-t border-white/10 bg-night-900/50 py-20 sm:py-28">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4" data-animate>
        <div>
          <p class="eyebrow">Chi esplora</p>
          <h2 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">Il team</h2>
        </div>
        <a href="/autori/" class="text-sm font-medium text-brand-400 transition hover:text-brand-300">
          Tutti gli autori →
        </a>
      </div>
      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {authors.map((author) => (
          <div data-animate>
            <AuthorCard author={author} count={countFor(author.id)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section data-reveal class="container-page py-20 sm:py-28">
    <div
      class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-night-800 to-night-900 px-8 py-16 text-center sm:px-16"
      data-animate
    >
      <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-brand-500/20 blur-3xl"></div>
      <h2 class="relative font-display text-3xl font-semibold text-white sm:text-4xl">
        Hai un posto o un evento da segnalarci?
      </h2>
      <p class="relative mx-auto mt-4 max-w-xl text-neutral-400">
        Scrivici: se merita davvero, andiamo a vederlo e lo raccontiamo.
      </p>
      <a
        href="/contatti/"
        class="relative mt-8 inline-block rounded-lg bg-brand-500 px-6 py-3 text-sm font-semibold text-night-950 transition hover:bg-brand-400"
      >
        Contattaci
      </a>
    </div>
  </section>
</BaseLayout>
