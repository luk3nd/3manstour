---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, SITE, STATS, categoryLabel } from '../config';
import { organization } from '../lib/schema';
import { formatDate } from '../lib/utils';

import '../styles/home.css';

// --- Hero: usa il primo file "hero-*" in src/assets, altrimenti la foto storica.
const heroModules = import.meta.glob<{ default: ImageMetadata }>('../assets/hero-*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const heroImage =
  Object.values(heroModules)[0]?.default ??
  (await import('../assets/3mans-tour-in-viaggio.jpg')).default;

// --- Dati editoriali
const byDate = (a: { data: { pubDate: Date } }, b: { data: { pubDate: Date } }) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate);
const authors = (await getCollection('authors')).sort((a, b) => a.id.localeCompare(b.id));
const galleryRaw = (await getCollection('gallery', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);

const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const journalPosts = posts.filter((post) => post.id !== featuredPost?.id).slice(0, 3);
const [leadPost, ...smallPosts] = journalPosts;

const gallery = await Promise.all(
  galleryRaw.map(async (item) => ({
    image: item.data.image,
    alt: item.data.alt,
    caption: item.data.caption ?? '',
    full: await getImage({ src: item.data.image, width: 1600, format: 'webp' }),
  })),
);

// --- Immagini delle categorie
import fiereImg from '../assets/fiere.jpg';
import ristorantiImg from '../assets/ristoranti.jpg';
import luoghiImg from '../assets/luoghi.jpg';
import esperienzeImg from '../assets/esperienze.jpg';
import aboutImage from '../assets/about-tremalzo.webp';

const topicImages: Record<string, ImageMetadata> = {
  fiere: fiereImg,
  ristoranti: ristorantiImg,
  luoghi: luoghiImg,
  esperienze: esperienzeImg,
};

const topics = CATEGORIES.map((category, i) => ({
  ...category,
  image: topicImages[category.slug],
  letter: ['A', 'B', 'C', 'D'][i] ?? '',
}));

const kmLabel = String(STATS.km).replace(/\B(?=(\d{3})+(?!\d))/g, '.');

// --- Instagram (griglia curata a mano)
import ig1 from '../assets/instagram/instagram-1.jpg';
import ig2 from '../assets/instagram/instagram-2.jpg';
import ig3 from '../assets/instagram/instagram-3.jpg';
import ig4 from '../assets/instagram/instagram-4.jpg';
import ig5 from '../assets/instagram/instagram-5.jpg';
import ig6 from '../assets/instagram/instagram-6.jpg';

const instagram = [
  { img: ig1, url: 'https://www.instagram.com/3m.ontour/reel/DXPZugejB-y/', alt: 'Giornata al Vinitaly 2026', caption: 'La fiera che non ti aspetti' },
  { img: ig2, url: 'https://www.instagram.com/3m.ontour/reel/DWb0CKtDEAX/', alt: 'Forma d’arte in bronzo', caption: 'Piazza, 23:40' },
  { img: ig3, url: 'https://www.instagram.com/3m.ontour/reel/DWByvdeDO8A/', alt: 'Villa con vista', caption: 'L’ultima salita' },
  { img: ig4, url: 'https://www.instagram.com/3m.ontour/reel/DV4LHTjDDYm/', alt: 'Remember Vintage – Khafra Parfums', caption: 'Neve fuori stagione' },
  { img: ig5, url: 'https://www.instagram.com/3m.ontour/p/DSkU9KnDJfN/', alt: 'La casa dei vasi', caption: 'Cartolina, ma dal lato giusto' },
  { img: ig6, url: 'https://www.instagram.com/3m.ontour/p/DSNFz-ZDPXI/', alt: 'Piatto del ristorante', caption: 'Tremalzo, 16' },
];

const siteUrl = Astro.site ?? new URL(SITE.url);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: siteUrl.href,
    description: SITE.description,
    inLanguage: SITE.lang,
  },
  organization(siteUrl),
];
---

<BaseLayout jsonLd={jsonLd}>
  <div class="home-scope">
    <!-- ================= HERO ================= -->
    <section class="hero" id="top" aria-labelledby="hero-title">
      <Image
        class="hero__image"
        src={heroImage}
        alt=""
        widths={[640, 960, 1280, 1920, 2400]}
        sizes="100vw"
        format="webp"
        fetchpriority="high"
        decoding="async"
        data-parallax="0.05"
      />
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__grid" aria-hidden="true"><span></span><span></span><span></span></div>

      <div class="container hero__inner">
        <div class="hero__content">
          <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Documentazione sul campo · dal 2023</p>
          <h1 id="hero-title">Non i posti più visti. <em>Quelli giusti.</em></h1>
          <p class="hero__lead">{SITE.description}</p>
          <div class="hero__actions">
            <a class="btn btn--orange" href="/blog">
              <span>Esplora i reportage</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" /></svg>
            </a>
            <a class="btn btn--ghost" href="#chi-siamo">
              <span>Chi siamo</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" /></svg>
            </a>
          </div>
        </div>

        <div class="hero__bottom">
          <div class="hero__foot">
            <a class="scroll-cue" href="#chi-siamo">
              <span>Scorri</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13M4.5 10.5 10 16l5.5-5.5" /></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <div class="ticker" aria-hidden="true"></div>

    <!-- ================= CHI SIAMO ================= -->
    <section class="section about" id="chi-siamo" aria-labelledby="about-title">
      <div class="container">
        <div class="section-head">
          <p class="section-index" data-reveal>01 — Chi siamo</p>
          <div class="section-head__main">
            <h2 id="about-title" data-reveal>Tre persone.<br />Nessuna guida.<br /><em>Solo curiosità.</em></h2>
            <p class="section-head__lead" data-reveal style="--delay:80ms">
              Siamo Guido, Luca e Stefano. Da Brescia in su, e poi ovunque ci sia qualcosa che non
              torna nella versione ufficiale.
            </p>
          </div>
        </div>

        <div class="about__grid">
          <figure class="about__media" data-reveal>
            <Image
              src={aboutImage}
              alt="I tre di 3 Man’s Tour davanti al cartello del Tremalzo"
              widths={[640, 960, 1200]}
              sizes="(min-width: 900px) 52vw, 100vw"
              format="webp"
              loading="lazy"
              decoding="async"
              data-parallax="0.04"
            />
            <figcaption><span>Tremalzo, 16</span> — la prima uscita che ci ha dato un nome.</figcaption>
          </figure>

          <div class="about__copy">
            <p class="about__intro" data-reveal>
              Cerchiamo il lato poco conosciuto delle cose: una fiera di nicchia, un rifugio fuori
              stagione, una struttura che nessuno fotografa, un pezzo di montagna che resta fuori
              dalle cartoline. Non andiamo a caccia dell’insolito a tutti i costi. Andiamo a vedere, e
              poi raccontiamo.
            </p>
            <p class="about__text" data-reveal style="--delay:60ms">
              Niente itinerari perfetti. Solo appunti, immagini e dettagli che aiutano a capire se un
              posto fa per te.
            </p>

            <ul class="team" data-reveal style="--delay:120ms" aria-label="Il trio">
              {
                authors.map((author, i) => (
                  <li>
                    <span class="team__num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="team__name">{author.data.name}</span>
                    <span class="team__role">{author.data.role}</span>
                  </li>
                ))
              }
            </ul>

            <p class="about__place" data-reveal style="--delay:160ms">
              <span class="dot" aria-hidden="true"></span>Brescia, Italia · dal 2023
            </p>
          </div>
        </div>

        <div class="method" data-reveal>
          <div class="method__head">
            <p class="micro">Il nostro approccio</p>
            <h3>Prima si ascolta.<br />Poi si <em>racconta.</em></h3>
            <p class="method__lead">
              Non arriviamo con una storia già scritta. Ci prendiamo il tempo di capire come funziona
              un posto, chi lo attraversa e cosa lo rende diverso.
            </p>
          </div>
          <ol class="method__steps">
            <li>
              <span>01</span><strong>Esplorazione sul campo</strong>
              <p>Ci andiamo, camminiamo, restiamo il tempo che serve.</p>
            </li>
            <li>
              <span>02</span><strong>Incontri e ricerca</strong>
              <p>Parliamo con chi il posto lo vive, non solo con chi lo gestisce.</p>
            </li>
            <li>
              <span>03</span><strong>Immagini, appunti, racconto</strong>
              <p>Restituiamo quello che abbiamo visto, senza brochure.</p>
            </li>
          </ol>
        </div>

        <blockquote class="manifesto" data-reveal>
          <span class="manifesto__mark" aria-hidden="true">✳</span>
          <p>“Non cerchiamo l’insolito. Cerchiamo il <em>punto di vista.</em>”</p>
          <cite>— il nostro metodo, in una riga</cite>
          <div class="manifesto__actions">
            <a class="btn btn--ghost" href="/contatti">
              <span>Parliamone</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" /></svg>
            </a>
            <p class="micro">Hai un luogo che merita un reportage?</p>
          </div>
        </blockquote>
      </div>
    </section>

    <!-- ================= ARGOMENTI ================= -->
    <section class="section topics" id="argomenti" aria-labelledby="topics-title">
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <p class="section-index" data-reveal>02 — Argomenti</p>
            <h2 id="topics-title" data-reveal>Cosa finisce<br />nel <em>mirino.</em></h2>
          </div>
          <div class="section-head__aside">
            <p data-reveal>Quattro porte d’ingresso. Sempre la stessa domanda: cosa c’è che non si vede?</p>
            <a class="text-link" href="/blog" data-reveal>Tutti i reportage <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="topics__grid">
          {
            topics.map((topic, i) => (
              <a class="topic" href={`/blog/categoria/${topic.slug}`} data-reveal style={`--delay:${i * 60}ms`}>
                <Image
                  src={topic.image}
                  alt=""
                  widths={[480, 720, 960]}
                  sizes="(min-width: 800px) 50vw, 100vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
                <span class="topic__letter">{topic.letter}</span>
                <span class="topic__body">
                  <span class="topic__title">{topic.label}</span>
                  <span class="topic__desc">{topic.description}</span>
                  <span class="topic__arrow" aria-hidden="true">
                    <svg viewBox="0 0 20 20"><path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" /></svg>
                  </span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= IN EVIDENZA ================= -->
    {
      featuredPost && (
        <section class="section feature" id="reportage" aria-labelledby="feature-title">
          <div class="container feature__grid">
            <figure class="feature__media" data-reveal>
              <Image
                src={featuredPost.data.cover}
                alt={featuredPost.data.coverAlt ?? featuredPost.data.title}
                widths={[600, 900, 1200]}
                sizes="(min-width: 900px) 42vw, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
                data-parallax="0.04"
              />
              <figcaption>
                <span>Reportage</span> {categoryLabel(featuredPost.data.category)}
              </figcaption>
            </figure>

            <div class="feature__body">
              <p class="section-index" data-reveal>Reportage scelto</p>
              <p class="micro" data-reveal>
                In evidenza · {categoryLabel(featuredPost.data.category)}
              </p>
              <h2 id="feature-title" data-reveal>{featuredPost.data.title}</h2>
              <p class="feature__lead" data-reveal>{featuredPost.data.description}</p>

              {
                featuredPost.data.highlights.length > 0 && (
                  <div class="found" data-reveal>
                    <p class="micro">Cosa abbiamo trovato</p>
                    <ul>
                      {featuredPost.data.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  </div>
                )
              }

              {(() => {
                const meta = [
                  { k: 'Dove', v: featuredPost.data.place },
                  { k: 'Quota', v: featuredPost.data.altitude },
                  { k: 'Tempo', v: featuredPost.data.duration },
                  { k: 'Con chi', v: featuredPost.data.withWhom },
                ].filter((item): item is { k: string; v: string } => Boolean(item.v));
                return (
                  meta.length > 0 && (
                    <dl class="feature__meta" data-reveal>
                      {meta.map((item) => (
                        <div>
                          <dt>{item.k}</dt>
                          <dd>{item.v}</dd>
                        </div>
                      ))}
                    </dl>
                  )
                );
              })()}

              <a class="btn btn--orange" href={`/blog/${featuredPost.id}`} data-reveal>
                <span>Leggi il reportage</span>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" /></svg>
              </a>
            </div>
          </div>
        </section>
      )
    }

    <!-- ================= NUMERI ================= -->
    <section class="numbers" id="numeri" aria-labelledby="numbers-title">
      <div class="container">
        <div class="numbers__head">
          <p class="section-index section-index--dark" data-reveal>03 — Il conto</p>
          <h2 id="numbers-title" data-reveal>Quello che abbiamo<br />visto <em>finora.</em></h2>
          <p class="numbers__note" data-reveal>Aggiornato a {STATS.updated}. Il prossimo posto è già in lista.</p>
        </div>

        <div class="stats" data-reveal>
          <div class="stat">
            <span class="stat__value" data-count={STATS.people} data-pad="2">0{STATS.people}</span>
            <span class="stat__label">Persone</span>
            <span class="stat__desc">Guido, Luca, Stefano. Nessun altro.</span>
          </div>
          <div class="stat">
            <span class="stat__value" data-count={STATS.places}>{STATS.places}</span>
            <span class="stat__label">Luoghi</span>
            <span class="stat__desc">Documentati con foto, appunti e una seconda visita.</span>
          </div>
          <div class="stat">
            <span class="stat__value" data-count={STATS.fairs}>{STATS.fairs}</span>
            <span class="stat__label">Fiere</span>
            <span class="stat__desc">Da quelle di paese a quelle di settore.</span>
          </div>
          <div class="stat">
            <span class="stat__value" data-count={STATS.km} data-format="thousand">{kmLabel}</span>
            <span class="stat__label">Chilometri</span>
            <span class="stat__desc">In macchina, in moto e a piedi. Soprattutto a piedi.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= DIARIO ================= -->
    <section class="section journal" id="diario" aria-labelledby="journal-title">
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <p class="section-index" data-reveal>04 — Diario di bordo</p>
            <h2 id="journal-title" data-reveal>Appunti,<br />non <em>itinerari.</em></h2>
          </div>
          <div class="section-head__aside">
            <p data-reveal>Quello che abbiamo visto, scritto mentre era ancora fresco.</p>
            <a class="text-link" href="/blog" data-reveal>Tutti gli articoli <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="journal__grid">
          {
            leadPost && (
              <article class="post-card post-card--large" data-reveal>
                <a class="post-card__link" href={`/blog/${leadPost.id}`}>
                  <span class="post-card__media">
                    <Image
                      src={leadPost.data.cover}
                      alt={leadPost.data.coverAlt ?? leadPost.data.title}
                      widths={[640, 900, 1200]}
                      sizes="(min-width: 900px) 58vw, 100vw"
                      format="webp"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="post-card__cat">{categoryLabel(leadPost.data.category)}</span>
                  </span>
                  <span class="post-card__body">
                    <span class="post-card__meta">{formatDate(leadPost.data.pubDate)}</span>
                    <span class="post-card__title">{leadPost.data.title}</span>
                    <span class="post-card__excerpt">{leadPost.data.description}</span>
                    <span class="post-card__cta">Leggi <span aria-hidden="true">↗</span></span>
                  </span>
                </a>
              </article>
            )
          }

          <div class="journal__stack">
            {
              smallPosts.map((post, i) => (
                <article class="post-card post-card--small" data-reveal style={`--delay:${(i + 1) * 70}ms`}>
                  <a class="post-card__link" href={`/blog/${post.id}`}>
                    <span class="post-card__media">
                      <Image
                        src={post.data.cover}
                        alt={post.data.coverAlt ?? post.data.title}
                        widths={[320, 480]}
                        sizes="(min-width: 900px) 26vw, 40vw"
                        format="webp"
                        loading="lazy"
                        decoding="async"
                      />
                      <span class="post-card__cat">{categoryLabel(post.data.category)}</span>
                    </span>
                    <span class="post-card__body">
                      <span class="post-card__meta">{formatDate(post.data.pubDate)}</span>
                      <span class="post-card__title">{post.data.title}</span>
                      <span class="post-card__cta">Leggi <span aria-hidden="true">↗</span></span>
                    </span>
                  </a>
                </article>
              ))
            }

            <a class="journal__all" href="/blog" data-reveal style="--delay:200ms">
              <span class="journal__all-label">Archivio completo · {posts.length} reportage</span>
              <span class="journal__all-title">Tutte le storie,<br />in ordine di viaggio.</span>
              <span class="journal__all-cta">Vai all’archivio <span aria-hidden="true">↗</span></span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= GALLERIA ================= -->
    <section class="section gallery" id="galleria" aria-labelledby="gallery-title">
      <div class="container">
        <div class="section-head section-head--split gallery__head">
          <div>
            <p class="section-index" data-reveal>05 — Archivio visivo</p>
            <h2 id="gallery-title" data-reveal>Quello che resta<br />fuori dal <em>racconto.</em></h2>
          </div>
          <div class="gallery__controls" data-reveal>
            <p class="gallery__counter">
              <span data-gallery-current>01</span> — <span data-gallery-total>{String(gallery.length).padStart(2, '0')}</span>
            </p>
            <div class="gallery__buttons">
              <button class="round-btn" type="button" aria-label="Immagine precedente" data-gallery-prev>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H5M9.5 4.5 4 10l5.5 5.5" /></svg>
              </button>
              <button class="round-btn" type="button" aria-label="Immagine successiva" data-gallery-next>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" /></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="gallery__viewport" data-gallery-viewport>
        <div class="gallery__track" data-gallery-track>
          {
            gallery.map((item, i) => (
              <button
                class:list={['gallery__item', i % 3 === 0 && 'gallery__item--portrait']}
                type="button"
                data-gallery-index={i}
                data-full={item.full.src}
                data-caption={item.caption}
                data-alt={item.alt}
                aria-label={`Apri l’immagine: ${item.caption}`}
              >
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[480, 720, 960]}
                  sizes="(min-width: 900px) 31vw, 76vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
                <span class="gallery__cap">
                  <span>{String(i + 1).padStart(2, '0')}</span>
                  {item.caption}
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="container">
        <div class="gallery__progress" aria-hidden="true"><span data-gallery-progress></span></div>
        <p class="gallery__hint">Trascina o usa le frecce. Clicca per aprire.</p>
      </div>
    </section>

    <!-- ================= SOCIAL ================= -->
    <section class="section social" id="social" aria-labelledby="social-title">
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <p class="section-index" data-reveal>06 — Fuori dal sito</p>
            <h2 id="social-title" data-reveal><em>@3m.ontour</em></h2>
          </div>
          <div class="section-head__aside">
            <p data-reveal>Il dietro le quinte, in tempo reale. Storie, cadute e luoghi in anteprima.</p>
            <a class="text-link" href="https://www.instagram.com/3m.ontour/" target="_blank" rel="noopener" data-reveal>
              Seguici su Instagram <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="social__grid">
          {
            instagram.map((post, i) => (
              <a
                class="social__tile"
                href={post.url}
                target="_blank"
                rel="noopener"
                aria-label={`Apri Instagram: ${post.caption}`}
                data-reveal
                style={`--delay:${(i % 3) * 60}ms`}
              >
                <Image
                  src={post.img}
                  alt={post.alt}
                  widths={[320, 480, 640]}
                  sizes="(min-width: 800px) 33vw, 50vw"
                  format="webp"
                  loading="lazy"
                  decoding="async"
                />
                <span class="social__overlay">
                  <span>{post.caption}</span>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15 15 5M7 5h8v8" /></svg>
                </span>
              </a>
            ))
          }
        </div>

        <p class="social__note" data-reveal>Anteprima del feed · immagini dell’archivio 3 Man’s Tour</p>
      </div>
    </section>

    <!-- ================= CTA ================= -->
    <section class="cta" id="contatti" aria-labelledby="cta-title">
      <div class="container cta__grid">
        <div class="cta__copy">
          <p class="section-index section-index--dark" data-reveal>07 — Prossima tappa</p>
          <h2 id="cta-title" data-reveal>Il prossimo posto<br />lo scegliamo <em>insieme.</em></h2>
          <p class="cta__lead" data-reveal>
            Hai un luogo, una fiera o una struttura che merita un reportage? O vuoi semplicemente
            scriverci? Raccontacelo: se merita, andiamo a vederlo.
          </p>
          <p class="cta__alt" data-reveal>
            Preferisci scrivere una mail? <a href="mailto:info@3manstour.com?subject=Una%20storia%20da%20raccontare">Scrivici <span aria-hidden="true">↗</span></a>
          </p>
        </div>

        <div class="cta__form-wrap" data-reveal style="--delay:80ms">
          <div class="cta__form">
            <a class="btn btn--dark cta__submit" href="/contatti">
              <span>Raccontaci un posto</span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" /></svg>
            </a>
            <p class="cta__note">Ti rispondiamo noi, non un modulo automatico.</p>
          </div>
          <p class="cta__social">
            Oppure <a href="https://www.instagram.com/3m.ontour/" target="_blank" rel="noopener">seguici su Instagram ↗</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ================= LIGHTBOX ================= -->
    <dialog class="lightbox" id="lightbox" aria-labelledby="lightbox-caption">
      <button class="lightbox__close" type="button" aria-label="Chiudi la galleria" data-lightbox-close>
        <span></span><span></span>
      </button>
      <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Immagine precedente" data-lightbox-prev>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H5M9.5 4.5 4 10l5.5 5.5" /></svg>
      </button>
      <figure class="lightbox__figure">
        <img id="lightbox-img" data-lightbox-img src={gallery[0]?.full.src} alt="" />
        <figcaption id="lightbox-caption"></figcaption>
      </figure>
      <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Immagine successiva" data-lightbox-next>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" /></svg>
      </button>
    </dialog>
  </div>
</BaseLayout>

<script>
  const reduceMotion = () =>
    typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isStatic = () =>
    typeof window !== 'undefined' && new URLSearchParams(window.location.search).has('static');

  function initHome() {
    const scope = document.querySelector<HTMLElement>('.home-scope');
    if (!scope) return;

    // --- Reveal
    const reveals = Array.from(scope.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (reduceMotion() || isStatic()) {
      reveals.forEach((el) => el.classList.add('is-visible'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      reveals.forEach((el) => io.observe(el));
    }

    // --- Parallasse leggera
    const parallaxEls = Array.from(scope.querySelectorAll<HTMLElement>('[data-parallax]'));
    if (parallaxEls.length && !reduceMotion() && !isStatic()) {
      let frame: number | null = null;
      const update = () => {
        const vh = window.innerHeight;
        parallaxEls.forEach((el) => {
          const speed = Number(el.dataset.parallax || 0);
          const rect = el.getBoundingClientRect();
          const offset = (rect.top + rect.height / 2 - vh / 2) * speed;
          el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0) scale(1.06)`;
        });
        frame = null;
      };
      const onScroll = () => {
        if (frame !== null) return;
        frame = window.requestAnimationFrame(update);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      update();
    }

    // --- Count-up
    const formatCount = (value: number, el: HTMLElement) => {
      if (el.dataset.format === 'thousand') {
        return String(value).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      }
      const padding = Number(el.dataset.pad || 0);
      return String(value).padStart(padding, '0');
    };

    const runCounter = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      const duration = 1200;
      const start = performance.now();
      const tick = (now: number) => {
        const p = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = formatCount(Math.round(target * eased), el);
        if (p < 1) window.requestAnimationFrame(tick);
      };
      window.requestAnimationFrame(tick);
    };

    const counters = Array.from(scope.querySelectorAll<HTMLElement>('[data-count]'));
    if (reduceMotion() || isStatic()) {
      counters.forEach((el) => {
        el.textContent = formatCount(Number(el.dataset.count || 0), el);
      });
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              runCounter(entry.target as HTMLElement);
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.5 },
      );
      counters.forEach((el) => io.observe(el));
    }

    // --- Galleria
    const viewport = scope.querySelector<HTMLElement>('[data-gallery-viewport]');
    const track = scope.querySelector<HTMLElement>('[data-gallery-track]');
    const progress = scope.querySelector<HTMLElement>('[data-gallery-progress]');
    const currentLabel = scope.querySelector<HTMLElement>('[data-gallery-current]');
    const items = Array.from(scope.querySelectorAll<HTMLElement>('.gallery__item'));

    if (viewport && track && items.length) {
      let raf: number | null = null;
      const updateGallery = () => {
        const viewportRect = viewport.getBoundingClientRect();
        let nearest = 0;
        let best = Infinity;
        items.forEach((item, index) => {
          const rect = item.getBoundingClientRect();
          const distance = Math.abs(rect.left - viewportRect.left);
          if (distance < best) {
            best = distance;
            nearest = index;
          }
        });
        if (currentLabel) currentLabel.textContent = String(nearest + 1).padStart(2, '0');

        const maxScroll = viewport.scrollWidth - viewport.clientWidth;
        const ratio = maxScroll > 0 ? viewport.scrollLeft / maxScroll : 0;
        if (progress) progress.style.width = `${Math.max(6, ratio * 100)}%`;
      };

      viewport.addEventListener(
        'scroll',
        () => {
          if (raf !== null) return;
          raf = window.requestAnimationFrame(() => {
            updateGallery();
            raf = null;
          });
        },
        { passive: true },
      );

      const scrollBy = (direction: number) => {
        const first = items[0];
        const width = first.getBoundingClientRect().width + 14;
        viewport.scrollBy({ left: direction * width, behavior: reduceMotion() ? 'auto' : 'smooth' });
      };

      scope.querySelector('[data-gallery-prev]')?.addEventListener('click', () => scrollBy(-1));
      scope.querySelector('[data-gallery-next]')?.addEventListener('click', () => scrollBy(1));

      // Drag con il mouse (su touch resta lo scroll nativo)
      let dragging = false;
      let startX = 0;
      let startLeft = 0;
      viewport.addEventListener('pointerdown', (event) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        dragging = true;
        startX = event.clientX;
        startLeft = viewport.scrollLeft;
        viewport.classList.add('is-dragging');
      });
      viewport.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        viewport.scrollLeft = startLeft - (event.clientX - startX);
      });
      const endDrag = () => {
        dragging = false;
        viewport.classList.remove('is-dragging');
      };
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointerleave', endDrag);

      updateGallery();
    }

    // --- Lightbox
    const lightbox = scope.querySelector<HTMLDialogElement>('#lightbox');
    const lightboxImg = scope.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const lightboxCaption = scope.querySelector<HTMLElement>('#lightbox-caption');

    if (lightbox && lightboxImg && items.length) {
      let index = 0;

      const show = (i: number) => {
        index = (i + items.length) % items.length;
        const item = items[index];
        lightboxImg.src = item.dataset.full ?? '';
        lightboxImg.alt = item.dataset.alt ?? '';
        if (lightboxCaption) lightboxCaption.textContent = item.dataset.caption ?? '';
      };

      items.forEach((item, i) => {
        item.addEventListener('click', () => {
          show(i);
          lightbox.showModal();
        });
      });

      lightbox.querySelector('[data-lightbox-close]')?.addEventListener('click', () => lightbox.close());
      lightbox.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(index - 1));
      lightbox.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(index + 1));
      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) lightbox.close();
      });
      document.addEventListener('keydown', (event) => {
        if (!lightbox.open) return;
        if (event.key === 'ArrowLeft') show(index - 1);
        if (event.key === 'ArrowRight') show(index + 1);
      });
    }
  }

  document.addEventListener('astro:page-load', initHome);
</script>
