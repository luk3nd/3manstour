---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { uniqueTags } from '../../lib/utils';
import { SITE } from '../../config';
import { breadcrumb } from '../../lib/schema';
import type { Page } from 'astro';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props as { page: Page };
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const tags = uniqueTags(allPosts);

const siteUrl = Astro.site ?? new URL(SITE.url);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Esplora' }];
const jsonLd = breadcrumb(crumbs, siteUrl);
---

<BaseLayout
  title="Esplora"
  description="Il diario di 3 Man's Tour: fiere, locali, ristoranti, luoghi ed esperienze raccontati dal nostro team."
  jsonLd={jsonLd}
>
  <Hero
    eyebrow="Esplora"
    title="Il diario"
    subtitle="Fiere, locali, ristoranti, luoghi ed esperienze. Filtra per argomento o sfoglia l'archivio."
    breadcrumb={crumbs}
  />

  <section class="container-page py-12 sm:py-16">
    <div class="mb-8">
      <TagFilter tags={tags} />
    </div>

    {page.data[0] && (
 <div class="mb-6">
 <BlogCard post={page.data[0]} large />
 </div>
 )}

 <div class="grid gap-6 sm:grid-cols-2">
      {page.data.slice(1).map((post) => <BlogCard post={post} />)}
    </div>

    <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath="/blog" />
  </section>
</BaseLayout>
