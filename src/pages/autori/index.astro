---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const authors = (await getCollection('authors')).sort((a, b) => a.id.localeCompare(b.id));
const posts = await getCollection('blog', ({ data }) => !data.draft);
const countFor = (id: string) => posts.filter((p) => p.data.author.id === id).length;
---

<BaseLayout
  title="Autori"
  description="Il team di 3 Man's Tour: le persone che esplorano, riprendono e scrivono."
>
  <Hero
    eyebrow="Chi esplora"
    title="Gli autori"
    subtitle="Le persone che esplorano, riprendono e raccontano."
  />

  <section class="container-page pb-20">
    <div class="flex flex-col gap-12">
      {
        authors.map((author, i) => (
          <article class="author-row border-t border-white/10 pt-10">
            <figure class="about__media">
              <a href={`/autori/${author.id}`} aria-label={author.data.name}>
                <Image
                  src={author.data.avatar}
                  alt={author.data.name}
                  width={900}
                  height={900}
                  format="webp"
                  class="aspect-square w-full object-cover"
                />
              </a>
            </figure>

            <div class="about__copy">
              <p class="section-index">{String(i + 1).padStart(2, '0')} — Autore</p>
              <h2 class="page-title-lg mt-3">
                <a href={`/autori/${author.id}`} class="transition hover:text-brand-400">
                  {author.data.name}
                </a>
              </h2>
              <p class="micro mt-2">{author.data.role}</p>
              <p class="about__intro mt-5">{author.data.shortBio ?? author.data.bio}</p>

              <div class="mt-6 flex flex-wrap items-center gap-6">
                <span class="micro">{countFor(author.id)} articoli</span>
                <a class="text-link" href={`/autori/${author.id}`}>
                  Profilo <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
