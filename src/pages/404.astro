---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina non trovata" description="La pagina che cerchi non esiste." noindex>
  <section class="container-narrow flex flex-col items-center py-24 text-center sm:py-32">
    <p class="font-mono text-7xl font-semibold text-brand-500">404</p>
    <h1 class="mt-6 font-display text-3xl font-semibold text-white sm:text-4xl">Pagina non trovata</h1>
    <p class="mt-4 max-w-md text-neutral-400">
      La pagina che cerchi è stata spostata o non esiste più. Prova a tornare alla home o a
      sfogliare il diario.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="rounded-lg bg-brand-500 px-6 py-3 text-sm font-semibold text-night-950 transition hover:bg-brand-400">
        Torna alla home
      </a>
      <a href="/blog/" class="rounded-lg border border-white/20 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
        Vai al diario
      </a>
    </div>
  </section>
</BaseLayout>
