---
import { STATS } from '../config';

const km = String(STATS.km).replace(/\B(?=(\d{3})+(?!\d))/g, '.');

const items = [
  {
    value: String(STATS.people).padStart(2, '0'),
    label: 'Persone',
    description: 'Guido, Luca, Stefano. Nessun altro.',
  },
  {
    value: String(STATS.places),
    label: 'Luoghi',
    description: 'Documentati con foto, appunti e una seconda visita.',
  },
  {
    value: String(STATS.fairs),
    label: 'Fiere',
    description: 'Da quelle di paese a quelle di settore.',
  },
  {
    value: km,
    label: 'Chilometri',
    description: 'In macchina, in moto e a piedi. Soprattutto a piedi.',
  },
];
---

<section id="numeri" class="bg-brand-500 py-20 text-night-950 sm:py-28">
  <div class="container-page">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="section-index section-index--dark">03 — Il conto</p>
        <h2 class="mt-5 max-w-2xl font-display text-[clamp(2.25rem,5.2vw,4.25rem)] font-semibold leading-[0.92]">
          Quello che abbiamo visto <span class="text-white">finora.</span>
        </h2>
      </div>
      <p class="max-w-xs text-sm leading-relaxed text-night-950/70 lg:text-right">
        Aggiornato a {STATS.updated}. Il prossimo posto è già in lista.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-x-8 gap-y-10 border-t border-night-950/20 pt-8 sm:grid-cols-4">
      {
        items.map((item) => (
          <div data-animate>
            <p class="font-display text-5xl font-semibold leading-none sm:text-6xl">{item.value}</p>
            <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.18em] text-night-950/70">
              {item.label}
            </p>
            <p class="mt-2 text-sm leading-snug text-night-950/70">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
