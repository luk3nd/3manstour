---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../config';
import fallbackImage from '../assets/3mans-tour-in-viaggio.jpg';

interface Props {
  /** Foto di sfondo. Se assente usa quella storica del sito. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const { image = fallbackImage, imageAlt = '' } = Astro.props;
---

<section class="relative flex min-h-[88svh] items-end overflow-hidden">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    format="webp"
    data-hero-image
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-night-950 via-night-950/75 to-night-950/25"></div>

  <div class="container-page relative z-10 pb-16 pt-40">
    <p class="eyebrow" data-hero-item>3 in viaggio · dal 2023</p>

    <h1
      class="mt-6 max-w-5xl font-display text-[clamp(2.9rem,8vw,6.75rem)] font-semibold leading-[0.88] text-white"
      data-hero-item
    >
      Non i posti più visti. <em>Quelli giusti.</em>
    </h1>

    <p class="mt-7 max-w-xl text-base leading-relaxed text-neutral-300 sm:text-lg" data-hero-item>
      {SITE.description}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-3" data-hero-item>
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-lg bg-brand-500 px-6 py-3 text-sm font-semibold text-night-950 transition hover:bg-brand-400"
      >
        Esplora i reportage
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" />
        </svg>
      </a>
      <a
        href="/chi-siamo"
        class="inline-flex items-center gap-2 rounded-lg border border-white/25 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
      >
        Chi siamo
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" />
        </svg>
      </a>
    </div>
  </div>
</section>
