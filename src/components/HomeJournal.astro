---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';
import { categoryLabel } from '../config';
import { formatDate } from '../lib/utils';

interface Props {
  posts: CollectionEntry<'blog'>[];
  total: number;
}

const { posts, total } = Astro.props;
const [lead, ...rest] = posts;
---

<section id="diario" class="container-page py-20 sm:py-28">
  <SectionHead index="04 — Diario di bordo">
    <Fragment slot="title">
      Appunti,<br />non <em>itinerari.</em>
    </Fragment>
    <Fragment slot="aside">
      Quello che abbiamo visto, scritto mentre era ancora fresco.
      <a
        href="/blog"
        class="mt-3 block font-mono text-[10px] uppercase tracking-[0.16em] text-brand-400 transition hover:text-brand-300"
      >
        Tutti gli articoli ↗
      </a>
    </Fragment>
  </SectionHead>

  <div class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
    {
      lead && (
        <article class="group" data-animate>
          <a href={`/blog/${lead.id}`} class="block">
            <span class="relative block overflow-hidden rounded-2xl border border-white/10">
              <Image
                src={lead.data.cover}
                alt={lead.data.coverAlt ?? lead.data.title}
                widths={[640, 900, 1200]}
                sizes="(min-width:1024px) 55vw, 100vw"
                format="webp"
                class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
              <span class="absolute left-4 top-4 rounded bg-brand-500 px-2 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-night-950">
                {categoryLabel(lead.data.category)}
              </span>
            </span>

            <span class="mt-5 block font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-500">
              {formatDate(lead.data.pubDate)}
            </span>
            <h3 class="mt-2 font-display text-3xl font-semibold leading-[1] text-white transition group-hover:text-brand-400 sm:text-4xl">
              {lead.data.title}
            </h3>
            <span class="mt-3 block max-w-xl text-sm leading-relaxed text-neutral-400">
              {lead.data.description}
            </span>
            <span class="mt-4 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-brand-400">
              Leggi ↗
            </span>
          </a>
        </article>
      )
    }

    <div class="flex flex-col gap-6">
      {
        rest.map((post) => (
          <article class="group" data-animate>
            <a
              href={`/blog/${post.id}`}
              class="grid grid-cols-[120px_1fr] items-center gap-4 rounded-2xl border border-white/10 p-3 transition hover:border-white/20 sm:grid-cols-[160px_1fr]"
            >
              <span class="block overflow-hidden rounded-xl">
                <Image
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? post.data.title}
                  widths={[240, 360]}
                  sizes="160px"
                  format="webp"
                  class="aspect-square w-full object-cover transition duration-700 group-hover:scale-105"
                />
              </span>
              <span class="block">
                <span class="block font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-500">
                  {categoryLabel(post.data.category)} · {formatDate(post.data.pubDate)}
                </span>
                <span class="mt-1 block font-display text-xl font-semibold leading-tight text-white transition group-hover:text-brand-400">
                  {post.data.title}
                </span>
              </span>
            </a>
          </article>
        ))
      }

      <a
        href="/blog"
        class="group flex flex-col justify-between rounded-2xl border border-white/10 bg-night-900/60 p-6 transition hover:border-brand-500/50"
      >
        <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-500">
          Archivio completo · {total} reportage
        </span>
        <span class="mt-3 font-display text-2xl font-semibold leading-[1.05] text-white">
          Tutte le storie,<br />in ordine di viaggio.
        </span>
        <span class="mt-4 inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-brand-400">
          Vai all’archivio ↗
        </span>
      </a>
    </div>
  </div>
</section>
