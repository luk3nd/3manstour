---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from './SectionHead.astro';
import { CATEGORIES } from '../config';
import fiereImg from '../assets/fiere.jpg';
import ristorantiImg from '../assets/ristoranti.jpg';
import luoghiImg from '../assets/luoghi.jpg';
import esperienzeImg from '../assets/esperienze.jpg';

const images: Record<string, ImageMetadata> = {
  fiere: fiereImg,
  ristoranti: ristorantiImg,
  luoghi: luoghiImg,
  esperienze: esperienzeImg,
};

const letters = ['A', 'B', 'C', 'D'];
---

<section id="argomenti" class="container-page py-20 sm:py-28">
  <SectionHead index="02 — Argomenti">
    <Fragment slot="title">
      Cosa finisce<br />nel <em>mirino.</em>
    </Fragment>
    <Fragment slot="aside">
      Quattro porte d’ingresso. Sempre la stessa domanda: cosa c’è che non si vede?
      <a
        href="/blog"
        class="mt-3 block font-mono text-[10px] uppercase tracking-[0.16em] text-brand-400 transition hover:text-brand-300"
      >
        Tutti i reportage ↗
      </a>
    </Fragment>
  </SectionHead>

  <div class="mt-12 grid gap-4 sm:grid-cols-2">
    {
      CATEGORIES.map((cat, i) => (
        <a
          href={`/blog/categoria/${cat.slug}`}
          class="group relative flex min-h-[280px] flex-col justify-end overflow-hidden rounded-2xl border border-white/10 p-7"
          data-animate
        >
          <Image
            src={images[cat.slug]}
            alt=""
            widths={[480, 720, 960]}
            sizes="(min-width:640px) 50vw, 100vw"
            format="webp"
            class="absolute inset-0 h-full w-full object-cover opacity-70 transition duration-700 group-hover:opacity-90"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-night-950 via-night-950/55 to-transparent"></div>

          <span class="relative font-mono text-[10px] uppercase tracking-[0.2em] text-neutral-400">
            {letters[i]}
          </span>
          <h3 class="relative mt-2 font-display text-3xl font-semibold text-white sm:text-4xl">
            {cat.label}
          </h3>
          <p class="relative mt-1 max-w-xs text-sm leading-relaxed text-neutral-300">
            {cat.description}
          </p>

          <span class="absolute bottom-6 right-6 grid h-11 w-11 place-items-center rounded-full border border-white/30 text-white transition group-hover:border-brand-500 group-hover:bg-brand-500 group-hover:text-night-950">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" />
            </svg>
          </span>
        </a>
      ))
    }
  </div>
</section>
