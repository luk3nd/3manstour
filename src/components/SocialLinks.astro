---
interface Props {
  items: { label: string; href: string }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

{
  items.length > 0 && (
    <ul class:list={['flex flex-wrap items-center gap-x-4 gap-y-2', className]}>
      {items.map((item) => (
        <li>
          <a href={item.href} class="text-sm text-neutral-500 transition hover:text-brand-400" rel="noopener" target="_blank">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  )
}
