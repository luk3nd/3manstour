---
/**
 * Sezione "Domande frequenti" + markup `FAQPage`.
 * Le domande arrivano dal frontmatter (`faq:`) dell'articolo o della pagina.
 * Se non ce ne sono, la sezione non compare.
 *
 * Non ha un contenitore proprio: si adatta alla colonna in cui viene inserita.
 */
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items?: FaqItem[];
}

const { items = [] } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

{
  items.length > 0 && (
    <section id="faq" class="mt-12 scroll-mt-24">
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

      <p class="eyebrow">FAQ</p>
      <h2 class="mt-4 font-display text-2xl font-semibold text-white sm:text-3xl">
        Domande frequenti
      </h2>

      <div class="mt-8 divide-y divide-white/10 border-y border-white/10">
        {items.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 [&::-webkit-details-marker]:hidden">
              <h3 class="text-base font-semibold text-white sm:text-lg">{item.question}</h3>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="mt-1 shrink-0 text-neutral-500 transition group-open:rotate-180"
              >
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <p class="mt-3 text-base leading-relaxed text-neutral-400">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
