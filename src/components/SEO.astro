---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image,
  imageAlt = SITE.name,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = SITE.author,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const fullTitle =
  title && !title.includes(SITE.name) ? `${title} | ${SITE.name}` : title || SITE.title;
const canonical = new URL(Astro.url.pathname, siteUrl).href;

let ogImage = SITE.defaultOgImage;
if (image) {
  if (typeof image === 'string') {
    ogImage = image;
  } else {
    const optimized = await getImage({ src: image, width: 1200, format: 'jpeg' });
    ogImage = optimized.src;
  }
}
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{SITE.googleSiteVerification && (
  <meta name="google-site-verification" content={SITE.googleSiteVerification} />
)}
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Feed RSS`} href="/rss.xml" />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

<!-- Open Graph -->
<meta property="og:type" content={type === 'profile' ? 'profile' : type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={SITE.locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
{SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && <meta property="article:author" content={author} />}
