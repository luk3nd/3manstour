---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate, excerpt, slugify } from '../lib/utils';
import { categoryLabel } from '../config';
import TagList from './TagList.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, cover, coverAlt, tags, category } = post.data;
const tagSlugs = (tags ?? []).map((t) => slugify(t));
---

<article
  class="group flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-night-900 transition hover:-translate-y-1 hover:border-brand-500/50"
  data-post-card
  data-tags={tagSlugs.join(',')}
>
  <a href={`/blog/${post.id}`} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
    <Image
      src={cover}
      alt={coverAlt ?? title}
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 33vw, 100vw"
      format="webp"
      class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-105"
    />
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center justify-between gap-3">
      <a href={`/blog/categoria/${slugify(category)}`} class="eyebrow !text-brand-400 transition hover:!text-brand-300">
        {categoryLabel(category)}
      </a>
      <time datetime={isoDate(pubDate)} class="font-mono text-xs text-neutral-500">
        {formatDate(pubDate)}
      </time>
    </div>
    <h3 class="mt-3 text-lg font-semibold leading-snug text-white">
      <a href={`/blog/${post.id}`} class="transition hover:text-brand-400">{title}</a>
    </h3>
    <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-neutral-400">
      {excerpt(description, 150)}
    </p>
    <div class="mt-5 border-t border-white/10 pt-4">
      <TagList tags={tags ?? []} size="sm" />
    </div>
  </div>
</article>
