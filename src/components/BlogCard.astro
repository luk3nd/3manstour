---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categoryLabel } from '../config';
import { formatDate, slugify } from '../lib/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  large?: boolean;
}

const { post, large = false } = Astro.props;
const { title, description, pubDate, cover, coverAlt, tags, category } = post.data;
---

<article
  class:list={['post-card', large ? 'post-card--large' : 'post-card--small']}
  data-tags={(tags ?? []).map((tag) => slugify(tag)).join(',')}
>
  <a class="post-card__link" href={`/blog/${post.id}`}>
    <span class="post-card__media">
      <Image
        src={cover}
        alt={coverAlt ?? title}
        widths={large ? [640, 900, 1200] : [320, 480]}
        sizes={large ? '(min-width: 900px) 58vw, 100vw' : '(min-width: 900px) 30vw, 50vw'}
        format="webp"
        loading="lazy"
        decoding="async"
      />
      <span class="post-card__cat">{categoryLabel(category)}</span>
    </span>
    <span class="post-card__body">
      <span class="post-card__meta">{formatDate(pubDate)}</span>
      <span class="post-card__title">{title}</span>
      {large && description && <span class="post-card__excerpt">{description}</span>}
      <span class="post-card__cta">Leggi <span aria-hidden="true">↗</span></span>
    </span>
  </a>

  {
    tags && tags.length > 0 && (
      <div class="post-card__tags">
        {tags.map((tag) => (
          <a class="tag-chip" href={`/blog/tag/${slugify(tag)}`}>
            #{tag}
          </a>
        ))}
      </div>
    )
  }
</article>
