---
import { slugify } from '../lib/utils';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap items-center gap-2" data-tag-filter>
  <button type="button" class="tag-chip is-active" data-filter="all">Tutti</button>
  {
    tags.map((tag) => (
      <button type="button" class="tag-chip" data-filter={slugify(tag)}>
        #{tag}
      </button>
    ))
  }
</div>

<p class="mt-4 hidden text-sm text-neutral-500" data-filter-empty>
  Nessun articolo con questo tag in questa pagina.
  <a data-filter-link href="/blog/" class="font-medium text-brand-400 underline">Vedi tutto l'archivio</a>.
</p>

<script>
  const filterRoot = document.querySelector('[data-tag-filter]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post-card]'));
  const emptyMsg = document.querySelector('[data-filter-empty]');
  const emptyLink = document.querySelector<HTMLAnchorElement>('[data-filter-link]');

  if (filterRoot && cards.length) {
    const buttons = Array.from(filterRoot.querySelectorAll<HTMLButtonElement>('[data-filter]'));

    const apply = (filter: string) => {
      let visible = 0;
      for (const card of cards) {
        const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
        const show = filter === 'all' || tags.includes(filter);
        card.style.display = show ? '' : 'none';
        if (show) visible += 1;
      }
      emptyMsg?.classList.toggle('hidden', visible > 0);
      if (emptyLink) {
        emptyLink.href = filter === 'all' ? '/blog/' : `/blog/tag/${filter}/`;
      }
      buttons.forEach((b) => b.classList.toggle('is-active', b.dataset.filter === filter));
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => apply(btn.dataset.filter ?? 'all'));
    });

    const initial = new URLSearchParams(location.search).get('tag');
    if (initial) {
      const match = buttons.find((b) => b.dataset.filter === initial);
      if (match) apply(initial);
    }
  }
</script>
