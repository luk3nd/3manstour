---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/utils';
import { categoryLabel } from '../config';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<aside class="space-y-6">
  {
    posts.length > 0 && (
      <div class=" border border-white/10 bg-night-900 p-6">
        <p class="eyebrow">Ultimi articoli</p>
        <ul class="mt-5 space-y-5">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="group flex gap-4">
                <Image
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? post.data.title}
                  width={72}
                  height={72}
                  format="webp"
                  class="h-16 w-16 shrink-0 object-cover"
                />
                <div class="min-w-0">
                  <p class="font-mono text-[0.7rem] uppercase tracking-wider text-brand-400">
                    {categoryLabel(post.data.category)}
                  </p>
                  <h3 class="mt-1 line-clamp-2 text-sm font-semibold leading-snug text-white transition group-hover:text-brand-400">
                    {post.data.title}
                  </h3>
                  <time
                    datetime={isoDate(post.data.pubDate)}
                    class="mt-1 block font-mono text-xs text-neutral-500"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/blog"
          class="mt-5 inline-block text-sm font-medium text-brand-400 transition hover:text-brand-300"
        >
          Tutti gli articoli →
        </a>
      </div>
    )
  }

  <div class="relative overflow-hidden border border-white/10 bg-gradient-to-br from-night-800 to-night-900 p-6">
    <div class="absolute -right-12 -top-12 h-32 w-32 bg-brand-500/20 blur-3xl"></div>
    <h2 class="relative text-lg font-semibold text-white">Hai un posto da segnalarci?</h2>
    <p class="relative mt-2 text-sm leading-relaxed text-neutral-400">
      Scrivici: se merita davvero, andiamo a vederlo e lo raccontiamo.
    </p>
    <a
      href="/contatti"
      class="relative mt-4 inline-block bg-brand-500 px-4 py-2 text-sm font-semibold text-night-950 transition hover:bg-brand-400"
    >
      Suggerisci un luogo
    </a>
  </div>
</aside>
