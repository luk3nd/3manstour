---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from './SectionHead.astro';

interface Item {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const total = String(items.length).padStart(2, '0');

// Versione grande per il lightbox (una sola larghezza, niente srcset).
const gallery = await Promise.all(
  items.map(async (item) => ({
    ...item,
    full: await getImage({ src: item.image, width: 1600, format: 'webp' }),
  })),
);
---

<section id="galleria" class="py-20 sm:py-28">
  <div class="container-page">
    <SectionHead index="05 — Archivio visivo">
      <Fragment slot="title">
        Quello che resta<br />fuori dal <em>racconto.</em>
      </Fragment>
      <Fragment slot="aside">
        <div class="flex items-center justify-end gap-3">
          <p class="font-mono text-[11px] tracking-[0.16em] text-neutral-500">
            <span data-gallery-current>01</span> — {total}
          </p>
          <button
            type="button"
            class="grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white transition hover:border-brand-500 hover:text-brand-400"
            aria-label="Immagine precedente"
            data-gallery-prev
          >
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 10H5M9.5 4.5 4 10l5.5 5.5" />
            </svg>
          </button>
          <button
            type="button"
            class="grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white transition hover:border-brand-500 hover:text-brand-400"
            aria-label="Immagine successiva"
            data-gallery-next
          >
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" />
            </svg>
          </button>
        </div>
      </Fragment>
    </SectionHead>
  </div>

  <div
    class="mt-10 overflow-x-auto px-[clamp(1.25rem,4vw,2.5rem)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-gallery-viewport
  >
    <ul class="flex snap-x snap-mandatory gap-4 pb-1">
      {
        gallery.map((item, i) => (
          <li class="w-[76vw] shrink-0 snap-start sm:w-[46vw] lg:w-[31vw]">
            <button
              type="button"
              class="group relative block w-full overflow-hidden rounded-2xl border border-white/10 text-left"
              data-gallery-item
              data-full={item.full.src}
              data-caption={item.caption ?? ''}
              data-alt={item.alt}
            >
              <Image
                src={item.image}
                alt={item.alt}
                widths={[480, 720, 960]}
                sizes="(min-width:1024px) 31vw, 76vw"
                format="webp"
                class="aspect-[4/5] w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
              <span class="absolute inset-x-0 bottom-0 flex items-baseline gap-3 bg-gradient-to-t from-night-950/95 to-transparent p-5 pt-20">
                <span class="font-mono text-[10px] text-brand-400">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-sm leading-snug text-white">{item.caption}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container-page mt-6">
    <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-500">
      Trascina o usa le frecce. Clicca per aprire.
    </p>
  </div>
</section>

<dialog
  id="gallery-lightbox"
  class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-night-950/95"
  aria-label="Galleria immagini"
>
  <div class="flex h-full flex-col p-4 sm:p-8">
    <div class="flex items-center justify-between gap-4">
      <p
        class="font-mono text-[10px] uppercase tracking-[0.16em] text-neutral-300"
        data-lightbox-caption
      >
      </p>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-full border border-white/20 text-white transition hover:border-brand-500 hover:text-brand-400"
        aria-label="Chiudi la galleria"
        data-lightbox-close
      >
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5l10 10M15 5 5 15" />
        </svg>
      </button>
    </div>

    <div class="flex flex-1 items-center justify-center gap-3 sm:gap-6">
      <button
        type="button"
        class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-white/20 text-white transition hover:border-brand-500 hover:text-brand-400"
        aria-label="Immagine precedente"
        data-lightbox-prev
      >
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 10H5M9.5 4.5 4 10l5.5 5.5" />
        </svg>
      </button>

      <img
        data-lightbox-img
        alt=""
        class="max-h-[78vh] max-w-[86vw] rounded-xl object-contain sm:max-w-[74vw]"
      />

      <button
        type="button"
        class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-white/20 text-white transition hover:border-brand-500 hover:text-brand-400"
        aria-label="Immagine successiva"
        data-lightbox-next
      >
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 10h11M10.5 4.5 16 10l-5.5 5.5" />
        </svg>
      </button>
    </div>
  </div>
</dialog>

<script>
  document.addEventListener('astro:page-load', () => {
    const dialog = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
    const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-item]'));
    const viewport = document.querySelector<HTMLElement>('[data-gallery-viewport]');
    const counter = document.querySelector<HTMLElement>('[data-gallery-current]');

    if (items.length === 0) return;

    // --- frecce del carosello ---
    const step = () => {
      const first = viewport?.querySelector('li');
      const width = first?.getBoundingClientRect().width ?? 320;
      return width + 16;
    };

    document
      .querySelector('[data-gallery-prev]')
      ?.addEventListener('click', () => viewport?.scrollBy({ left: -step(), behavior: 'smooth' }));
    document
      .querySelector('[data-gallery-next]')
      ?.addEventListener('click', () => viewport?.scrollBy({ left: step(), behavior: 'smooth' }));

    viewport?.addEventListener(
      'scroll',
      () => {
        if (!counter) return;
        const index = Math.round((viewport.scrollLeft / step()) + 1);
        counter.textContent = String(Math.min(items.length, Math.max(1, index))).padStart(2, '0');
      },
      { passive: true },
    );

    // --- lightbox ---
    if (!dialog) return;

    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
    let current = 0;

    const render = () => {
      const item = items[current];
      if (image) {
        image.src = item.dataset.full ?? '';
        image.alt = item.dataset.alt ?? '';
      }
      if (caption) caption.textContent = item.dataset.caption ?? '';
    };

    const move = (delta: number) => {
      current = (current + delta + items.length) % items.length;
      render();
    };

    items.forEach((item, index) => {
      item.addEventListener('click', () => {
        current = index;
        render();
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => move(-1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => move(1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') move(-1);
      if (event.key === 'ArrowRight') move(1);
    });
  });
</script>
