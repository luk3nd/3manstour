---
/**
 * Testata di sezione: indice numerato (01 — Chi siamo), titolo display e,
 * se presente, un testo laterale. Usata dalle sezioni della home.
 */
interface Props {
  index: string;
  /** "light" = sezione su fondo arancione (testo scuro). */
  tone?: 'dark' | 'light';
  class?: string;
}

const { index, tone = 'dark', class: className } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<div class:list={['border-t border-white/10 pt-6', className]}>
  <div
    class:list={[
      'flex flex-col gap-8',
      hasAside && 'lg:flex-row lg:items-end lg:justify-between lg:gap-16',
    ]}
  >
    <div class="max-w-3xl lg:flex-1">
      <p class:list={['section-index', tone === 'light' && 'section-index--dark']}>{index}</p>
      <h2
        class:list={[
          'mt-5 font-display text-[clamp(2.25rem,5.2vw,4.25rem)] font-semibold leading-[0.92]',
          tone === 'light' ? 'text-night-950' : 'text-white',
        ]}
      >
        <slot name="title" />
      </h2>
    </div>

    {
      hasAside && (
        <div class="max-w-sm shrink-0 text-sm leading-relaxed text-neutral-400 lg:text-right">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</div>
