---
import { Image } from 'astro:assets';
import { SOCIAL } from '../config';
import ig1 from '../assets/instagram/instagram-1.jpg';
import ig2 from '../assets/instagram/instagram-2.jpg';
import ig3 from '../assets/instagram/instagram-3.jpg';
import ig4 from '../assets/instagram/instagram-4.jpg';
import ig5 from '../assets/instagram/instagram-5.jpg';
import ig6 from '../assets/instagram/instagram-6.jpg';

/**
 * Blocco statico "curato": griglia dei post scelti a mano.
 * Le immagini sono le copertine dei post (in src/assets/instagram/), i link
 * puntano ai post reali. Per aggiornare basta sostituire immagini e URL qui.
 */
const posts = [
  { img: ig1, url: 'https://www.instagram.com/3m.ontour/reel/DXPZugejB-y/', alt: 'Giornata al Vinitaly 2026', reel: true },
  { img: ig2, url: 'https://www.instagram.com/3m.ontour/reel/DWb0CKtDEAX/', alt: 'Forma d’arte in bronzo', reel: true },
  { img: ig3, url: 'https://www.instagram.com/3m.ontour/reel/DWByvdeDO8A/', alt: 'Villa con vista', reel: true },
  { img: ig4, url: 'https://www.instagram.com/3m.ontour/reel/DV4LHTjDDYm/', alt: 'Remember Vintage – Khafra Parfums', reel: true },
  { img: ig5, url: 'https://www.instagram.com/3m.ontour/p/DSkU9KnDJfN/', alt: 'La casa dei vasi', reel: false },
  { img: ig6, url: 'https://www.instagram.com/3m.ontour/p/DSNFz-ZDPXI/', alt: 'Piatto del ristorante', reel: false },
];

const profile = SOCIAL.find((s) => s.label === 'Instagram')?.href ?? 'https://www.instagram.com/';
const handle = profile.replace(/\/+$/, '').split('/').pop();
---

<section data-reveal class="container-page py-20 sm:py-28">
  <div class="flex flex-wrap items-end justify-between gap-4" data-animate>
    <div>
      <p class="eyebrow">Dal nostro Instagram</p>
      <h2 class="mt-4 font-display text-3xl font-semibold text-white sm:text-4xl">
        Fuori dal sito, sempre in giro
      </h2>
    </div>
    <a
      href={profile}
      target="_blank"
      rel="noopener"
      class="text-sm font-medium text-brand-400 transition hover:text-brand-300"
    >
      @{handle} →
    </a>
  </div>

  <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:gap-4" data-animate>
    {
      posts.map((post) => (
        <a
          href={post.url}
          target="_blank"
          rel="noopener"
          class="group relative block aspect-square overflow-hidden rounded-2xl border border-white/10 bg-night-900"
        >
          <Image
            src={post.img}
            alt={post.alt}
            widths={[320, 480, 640]}
            sizes="(min-width:640px) 33vw, 50vw"
            format="webp"
            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-night-950/85 via-night-950/10 to-transparent opacity-0 transition group-hover:opacity-100" />
          {post.reel && (
            <span class="absolute right-3 top-3 grid h-8 w-8 place-items-center rounded-full bg-night-950/70 text-white backdrop-blur">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          )}
          <span class="absolute inset-x-0 bottom-0 flex items-center gap-2 p-4 text-xs font-medium text-white opacity-0 transition group-hover:opacity-100">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            Vedi su Instagram
          </span>
        </a>
      ))
    }
  </div>
</section>
