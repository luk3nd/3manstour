---
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TagList from '../components/TagList.astro';
import AuthorBio from '../components/AuthorBio.astro';
import PostToc from '../components/PostToc.astro';
import PostSidebar from '../components/PostSidebar.astro';
import Faq from '../components/Faq.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/utils';
import { categoryLabel, SITE } from '../config';
import { breadcrumb } from '../lib/schema';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  author: CollectionEntry<'authors'>;
  readingMinutes: number;
  headings: Heading[];
  latest: CollectionEntry<'blog'>[];
}

const { post, author, readingMinutes, headings, latest } = Astro.props;
const { title, description, pubDate, updatedDate, cover, coverAlt, tags, category, faq } =
  post.data;

// Se l'articolo ha delle FAQ, aggiungiamo la voce all'indice (la sezione ha id="faq")
const tocHeadings =
  faq.length > 0 ? [...headings, { depth: 2, slug: 'faq', text: 'Domande frequenti' }] : headings;

const siteUrl = Astro.site ?? new URL(SITE.url);
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Esplora', url: '/blog' },
  { name: categoryLabel(category), url: `/blog/categoria/${category}` },
  { name: title },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: {
      '@type': 'Person',
      name: author.data.name,
      url: new URL(`/autori/${author.id}`, siteUrl).href,
    },
    image: new URL(cover.src, siteUrl).href,
    articleSection: categoryLabel(category),
    mainEntityOfPage: new URL(Astro.url.pathname, siteUrl).href,
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: siteUrl.href,
      logo: { '@type': 'ImageObject', url: new URL('/favicon.png', siteUrl).href },
    },
  },
  breadcrumb(crumbs, siteUrl),
];
---

<BaseLayout
  type="article"
  title={title}
  description={description}
  image={cover}
  imageAlt={coverAlt ?? title}
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  author={author.data.name}
  jsonLd={jsonLd}
>
  <article>
    <Hero
      title={title}
      subtitle={description}
      image={cover}
      imageAlt={coverAlt ?? title}
      breadcrumb={crumbs}
    >
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-neutral-300">
        <a href={`/autori/${author.id}`} class="flex items-center gap-2 transition hover:text-white">
          
          <span class="font-medium">{author.data.name}</span>
        </a>
        <span aria-hidden="true" class="text-neutral-600">·</span>
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true" class="text-neutral-600">·</span>
        <span>{readingMinutes} min di lettura</span>
      </div>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-4">
        <a href={`/blog/categoria/${category}`} class="eyebrow !text-brand-400 transition hover:!text-brand-300">
          {categoryLabel(category)}
        </a>
        <TagList tags={tags} variant="dark" />
      </div>
    </Hero>

    <div class="container-page py-14">
      <div
        class="grid gap-10 xl:grid-cols-[minmax(0,13rem)_minmax(0,1fr)_minmax(0,17rem)] xl:gap-12"
      >
        <!-- Indice dei titoli (collassabile su mobile, colonna sinistra da xl) -->
        <aside class="xl:sticky xl:top-24 xl:self-start">
          <PostToc headings={tocHeadings} />
        </aside>

        <!-- Articolo -->
        <div class="min-w-0">
          <div class="prose">
            <slot />
          </div>

          <Faq items={faq} />

          {updatedDate && (
            <p class="mt-10 text-sm text-neutral-500">
              Ultimo aggiornamento: {formatDate(updatedDate)}
            </p>
          )}

          <AuthorBio author={author} />
        </div>

        <!-- Ultimi articoli + CTA (colonna destra da xl) -->
        <div class="xl:sticky xl:top-24 xl:self-start">
          <PostSidebar posts={latest} />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
