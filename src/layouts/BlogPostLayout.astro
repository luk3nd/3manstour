---
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TagList from '../components/TagList.astro';
import AuthorBio from '../components/AuthorBio.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/utils';
import { categoryLabel, SITE } from '../config';

interface Props {
  post: CollectionEntry<'blog'>;
  author: CollectionEntry<'authors'>;
  readingMinutes: number;
}

const { post, author, readingMinutes } = Astro.props;
const { title, description, pubDate, updatedDate, cover, coverAlt, tags, category } = post.data;

const siteUrl = Astro.site ?? new URL(SITE.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author.data.name,
    url: new URL(`/autori/${author.id}/`, siteUrl).href,
  },
  image: new URL(cover.src, siteUrl).href,
  articleSection: categoryLabel(category),
  mainEntityOfPage: new URL(Astro.url.pathname, siteUrl).href,
  publisher: { '@type': 'Organization', name: SITE.name },
};
---

<BaseLayout
  type="article"
  title={title}
  description={description}
  image={cover}
  imageAlt={coverAlt ?? title}
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  author={author.data.name}
  jsonLd={jsonLd}
>
  <article>
    <Hero title={title} subtitle={description} image={cover} imageAlt={coverAlt ?? title}>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-neutral-300">
        <a href={`/autori/${author.id}/`} class="flex items-center gap-2 transition hover:text-white">
          <Image
            src={author.data.avatar}
            alt={author.data.name}
            width={32}
            height={32}
            format="webp"
            class="h-8 w-8 rounded-full object-cover"
          />
          <span class="font-medium">{author.data.name}</span>
        </a>
        <span aria-hidden="true" class="text-neutral-600">·</span>
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true" class="text-neutral-600">·</span>
        <span>{readingMinutes} min di lettura</span>
      </div>
      <div class="mt-5 flex flex-wrap items-center justify-center gap-4">
        <a href={`/blog/categoria/${category}/`} class="eyebrow !text-brand-400 transition hover:!text-brand-300">
          {categoryLabel(category)}
        </a>
        <TagList tags={tags} variant="dark" />
      </div>
    </Hero>

    <div class="container-narrow py-14">
      <div class="prose">
        <slot />
      </div>

      {updatedDate && (
        <p class="mt-10 text-sm text-neutral-500">
          Ultimo aggiornamento: {formatDate(updatedDate)}
        </p>
      )}

      <AuthorBio author={author} />
    </div>
  </article>
</BaseLayout>
