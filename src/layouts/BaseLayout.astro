---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../config';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { jsonLd, ...seo } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#080808" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />

    <!-- DIAGNOSI TEMPORANEA: traccia le richieste a Google Analytics -->
    <script is:inline>
      window.__gaReq = [];
      (function () {
        var sb = navigator.sendBeacon && navigator.sendBeacon.bind(navigator);
        if (sb)
          navigator.sendBeacon = function (u, d) {
            window.__gaReq.push(String(u));
            return sb(u, d);
          };
        var f = window.fetch && window.fetch.bind(window);
        if (f)
          window.fetch = function (u, o) {
            window.__gaReq.push(String(u));
            return f(u, o);
          };
      })();
    </script>

    <!-- Google tag (gtag.js) — TEST STATICO -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-F4HMDVHG4N"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-F4HMDVHG4N');
      setTimeout(function () {
        var hasGa = document.cookie.indexOf('_ga') !== -1;
        var req = (window.__gaReq || []).some(function (u) {
          return /google-analytics/.test(u);
        });
        document.title = '[ga=' + (hasGa ? 'y' : 'n') + ' req=' + (req ? 'y' : 'n') + '] ' + document.title;
      }, 6000);
    </script>

    <script is:inline>
      document.documentElement.classList.add('js');
      window.addEventListener('load', function () {
        if (!window.__animReady) document.documentElement.classList.remove('js');
      });
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-night-950">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>

<script>
  import { initAnimations } from '../scripts/animations';

  // Con le View Transitions, astro:page-load scatta al primo caricamento e dopo ogni navigazione.
  document.addEventListener('astro:page-load', initAnimations);
</script>
