---
import BaseLayout from './BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../config';

interface Props {
  author: CollectionEntry<'authors'>;
  posts: CollectionEntry<'blog'>[];
}

const { author, posts } = Astro.props;
const { name, role, bio, avatar, socials } = author.data;

const siteUrl = Astro.site ?? new URL(SITE.url);

const socialEntries = Object.entries(socials ?? {}).filter(([, href]) =>
  Boolean(href),
) as [string, string][];
const sameAs = socialEntries.map(([, href]) => href);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name,
    description: bio,
    image: new URL(avatar.src, siteUrl).href,
    url: new URL(Astro.url.pathname, siteUrl).href,
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
};

const socialItems = socialEntries.map(([key, href]) => ({
  label: key.charAt(0).toUpperCase() + key.slice(1),
  href,
}));
---

<BaseLayout
  type="profile"
  title={`${name} — ${role}`}
  description={bio}
  image={avatar}
  imageAlt={name}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container-page">
      <div class="about__grid">
        <figure class="about__media">
          <Image
            src={avatar}
            alt={name}
            width={900}
            height={900}
            format="webp"
            class="aspect-square w-full object-cover"
          />
        </figure>

        <div class="about__copy">
          <p class="section-index">Autore</p>
          <h1 class="page-title mt-4">{name}</h1>
          <p class="micro mt-2">{role}</p>
          <p class="about__intro mt-6">{bio}</p>
          <SocialLinks items={socialItems} class="mt-6" />
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl font-semibold text-white">Articoli di {name}</h2>
      <span class="font-mono text-sm text-neutral-500">{posts.length} {posts.length === 1 ? 'articolo' : 'articoli'}</span>
    </div>
    {
      posts.length > 0 ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-neutral-500">Nessun articolo pubblicato ancora.</p>
      )
    }
  </section>
</BaseLayout>
