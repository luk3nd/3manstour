---
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Faq from '../components/Faq.astro';
import type { ImageMetadata } from 'astro';
import { SITE } from '../config';
import { webPage } from '../lib/schema';

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  description?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  faq?: { question: string; answer: string }[];
}

const { title, subtitle, eyebrow, description, cover, coverAlt, jsonLd, faq } = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const schema =
  jsonLd ??
  webPage({ name: title, description: description ?? subtitle, url: Astro.url.pathname }, siteUrl);
---

<BaseLayout
  title={title}
  description={description ?? subtitle ?? title}
  image={cover}
  imageAlt={coverAlt}
  jsonLd={schema}
>
  <Hero title={title} subtitle={subtitle} eyebrow={eyebrow} image={cover} imageAlt={coverAlt} />

  <div class="container-narrow py-14 sm:py-20">
    <article class="prose">
      <slot />
    </article>

    <Faq items={faq} />
  </div>
</BaseLayout>
